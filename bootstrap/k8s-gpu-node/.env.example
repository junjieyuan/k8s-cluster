# Generate password hash: openssl passwd -6
K8S_PASSWORD_HASH='<PASTE_YOUR_PASSWORD_HASH_HERE>'
# SSH public key for the core user
K8S_SSH_PUB_KEY='<PASTE_YOUR_SSH_PUBLIC_KEY_HERE>'
# Node hostname
K8S_HOSTNAME=k8s-gpu-worker-001
# Package version streams (space-separated rpm-ostree packages)
K8S_PREINSTALLED_PACKAGES="cri-o1.36 kubernetes1.36"
# GPU PCI devices for passthrough (space-separated B:D:F, find with: lspci -nn | grep -i nvidia)
K8S_GPU_DEVICES='0000:01:00.0 0000:01:00.1'
# Host directory for virtiofs passthrough (e.g. HuggingFace cache)
K8S_VIRTIOFS_SOURCE='/home/<USER>/.cache/huggingface/hub'
K8S_VIRTIOFS_TARGET='hf_hub'

# After provisioning, the VM will auto-reboot 3 times:
#   1. FCOS → uCore NVIDIA (unsigned)
#   2. uCore unsigned → signed
#   3. Install k8s packages (cri-o + kubernetes)
# Total ~6-7 min. Then deploy script attaches GPU PCI devices and virtiofs.
