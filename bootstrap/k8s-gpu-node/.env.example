# ---- Hardware resources ----
# Override with --cpus / --memory / --disk-size
K8S_CPUS=16
K8S_MEMORY=32768
K8S_DISK_SIZE=64

# ---- Node identity ----
K8S_HOSTNAME=k8s-gpu-worker-001

# ---- Authentication ----
# Generate password hash: openssl passwd -6
K8S_PASSWORD_HASH='<PASTE_YOUR_PASSWORD_HASH_HERE>'
# SSH public keys for the core user, one per line (multi-line value)
K8S_SSH_PUB_KEYS="
<PASTE_YOUR_SSH_PUBLIC_KEY_1_HERE>
<PASTE_YOUR_SSH_PUBLIC_KEY_2_HERE>
"

# ---- Packages ----
# Space-separated rpm-ostree package streams
K8S_PREINSTALLED_PACKAGES="cri-o1.36 kubernetes1.36"

# ---- GPU passthrough ----
# PCI devices (space-separated B:D:F), find with: lspci -nn | grep -i nvidia
K8S_GPU_DEVICES='0000:01:00.0 0000:01:00.1'

# ---- VirtioFS ----
# Host directory to passthrough (e.g. HuggingFace cache)
K8S_VIRTIOFS_SOURCE='/var/home/<USER>/.cache/huggingface/hub'
K8S_VIRTIOFS_TARGET='hf_hub'

# After provisioning, the VM will auto-reboot 3 times:
#   1. FCOS → uCore NVIDIA (unsigned)
#   2. uCore unsigned → signed
#   3. Install k8s packages (cri-o + kubernetes)
# Total ~6-7 min. Then deploy script attaches GPU PCI devices and virtiofs.
