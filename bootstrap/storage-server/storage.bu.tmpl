variant: fcos
version: "1.7.0"
passwd:
  users:
    - name: core
      password_hash: ${K8S_PASSWORD_HASH}
      ssh_authorized_keys:
        - ${K8S_SSH_PUB_KEY}
storage:
  files:
    - path: /etc/hostname
      mode: 0644
      contents:
        inline: ${K8S_HOSTNAME}
    - path: /etc/exports.d/k8s.exports
      mode: 0644
      contents:
        inline: |
          # no_root_squash is required: Kubernetes pods running as root need to
          # write to NFS-backed PVCs. The export is restricted to the cluster subnet.
          /var/nfs           ${K8S_NFS_SUBNET}(rw,sync,no_root_squash,no_subtree_check,fsid=0)
          /var/nfs/models    ${K8S_NFS_SUBNET}(ro,sync,no_subtree_check,crossmnt)
  directories:
    - path: /var/nfs
      mode: 0755
    - path: /var/nfs/models
      mode: 0755
    - path: /var/nfs/models/huggingface
      mode: 0755
systemd:
  units:
    # Install packages via rpm-ostree on first boot.
    # --reboot triggers a reboot after installation; --idempotent ensures
    # the service is a no-op on subsequent boots (packages already layered).
    - name: rpm-ostree-install-packages.service
      enabled: true
      contents: |
        [Unit]
        Description=Install required packages via rpm-ostree
        After=network-online.target
        Wants=network-online.target
        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/usr/bin/rpm-ostree install --reboot --idempotent --assumeyes ${K8S_PREINSTALLED_PACKAGES}
        [Install]
        WantedBy=multi-user.target
    # Mount HF Hub via virtiofs before NFS starts.
    # Uses a .mount unit (systemd-native) rather than a oneshot service —
    # systemd tracks mount state, handles unmount on shutdown automatically.
    # Unit name must match canonical path (systemd.mount(5)).
    - name: var-nfs-models-huggingface.mount
      enabled: true
      contents: |
        [Unit]
        Description=HuggingFace Hub virtiofs mount
        Before=nfs-server-enable.service
        [Mount]
        What=hfhub
        Where=/var/nfs/models/huggingface
        Type=virtiofs
        Options=ro,defaults
        DirectoryMode=0755

        [Install]
        WantedBy=multi-user.target
    # Enable NFS server after rpm-ostree installs the packages.
    # ConditionPathExists skips this unit on first boot (nfs-utils not yet layered);
    # on subsequent boots the condition passes and the service is enabled.
    - name: nfs-server-enable.service
      enabled: true
      contents: |
        [Unit]
        Description=Enable NFS server after packages are installed
        After=network-online.target rpm-ostree-install-packages.service var-nfs-models-huggingface.mount
        Wants=network-online.target var-nfs-models-huggingface.mount
        ConditionPathExists=/usr/sbin/rpc.nfsd
        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/usr/bin/systemctl enable --now nfs-server
        ExecStartPost=/usr/bin/systemctl disable nfs-server-enable.service
        [Install]
        WantedBy=multi-user.target
