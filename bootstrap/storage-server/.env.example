# ---- Hardware resources ----
# Override with --cpus / --memory / --disk-size
K8S_CPUS=2
K8S_MEMORY=4096
K8S_DISK_SIZE=128

# ---- Node identity ----
K8S_HOSTNAME=k8s-storage-001

# ---- Authentication ----
# Generate password hash: openssl passwd -6
K8S_PASSWORD_HASH='<PASTE_YOUR_PASSWORD_HASH_HERE>'
# SSH public key for the core user
K8S_SSH_PUB_KEY='<PASTE_YOUR_SSH_PUBLIC_KEY_HERE>'

# ---- Packages ----
# Space-separated rpm-ostree package streams
K8S_PREINSTALLED_PACKAGES=nfs-utils

# ---- NFS ----
# Export subnet (default: libvirt default NAT network)
K8S_NFS_SUBNET='192.168.122.0/24'
