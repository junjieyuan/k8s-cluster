# Generate password hash: openssl passwd -6
K8S_PASSWORD_HASH='<PASTE_YOUR_PASSWORD_HASH_HERE>'
# SSH public key for the core user
K8S_SSH_PUB_KEY='<PASTE_YOUR_SSH_PUBLIC_KEY_HERE>'
# Node hostname
K8S_HOSTNAME=k8s-storage-001
# Package version streams
K8S_PREINSTALLED_PACKAGES=nfs-utils
# Host directory to share via virtiofs (e.g., /var/lib/libvirt/hfhub).
# Leave empty to skip virtiofs configuration.
K8S_HFHUB_SOURCE=
# Hardware resources (override with --cpus / --memory / --disk-size)
K8S_CPUS=2
K8S_MEMORY=4096
K8S_DISK_SIZE=128
