# Generate password hash: openssl passwd -6
K8S_PASSWORD_HASH='<PASTE_YOUR_PASSWORD_HASH_HERE>'
# SSH public key for the core user
K8S_SSH_PUB_KEY='<PASTE_YOUR_SSH_PUBLIC_KEY_HERE>'
# Node hostname
K8S_HOSTNAME=k8s-control-plane-001
# Package version streams (space-separated rpm-ostree packages)
K8S_PREINSTALLED_PACKAGES="cri-o1.35 kubernetes1.35"
