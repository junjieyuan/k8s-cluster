---
{
  # KYAML formatter (KEP 5295 dialect): flow-style maps/lists, double-quoted
  # strings, trailing commas. See https://kubernetes.io/blog/2026/08/11/
  # how-to-pretty-print-kubernetes-yaml-as-kyaml/ for the rationale.
  formatter: {
    type: "kyaml",
  },
  # Vendored chart sources are third-party and gitignored; without this,
  # `yamlfmt -lint infrastructure/` fails on their templates.
  gitignore_excludes: true,
}
